# Beacon Frontend — Environment Variables
#
# Copy to .env.local and fill in your values.
# All variables are optional — when omitted the frontend proxies to the same
# origin (useful for development via the Vite dev server proxy).

# Full base URL of the Beacon API server (without trailing slash).
# Leave empty to use the Vite dev server proxy (see vite.config.ts).
# Example: https://beacon.example.com
VITE_API_BASE_URL=

# Full base URL for WebSocket connections.
# Leave empty to auto-derive from window.location (ws/wss + same host).
# Example: wss://beacon.example.com
VITE_WS_BASE_URL=

# API path prefix. Only change if you have a custom server config.
# Default: /api/v1
VITE_API_PREFIX=/api/v1

# WebSocket subscribe path. Only change if you have a custom server config.
# Default: /ws/subscribe/
VITE_WS_PATH=/ws/subscribe/

# Google OAuth Client ID (optional). Set if enabling Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# ATLAS-AI gateway (optional). If empty, the app will call the gateway on the same origin.
VITE_ATLAS_AI_BASE_URL=

# Enable/disable the ATLAS-AI panel in the UI.
VITE_ATLAS_AI_ENABLED=true
