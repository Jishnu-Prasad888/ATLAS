# Beacon Server Environment Variables
# Copy to .env and fill in values

SECRET_KEY=beacon-change-me-in-production-use-a-long-random-string-here
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-domain.com

# PostgreSQL
DB_NAME=beacon
DB_USER=beacon
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# TLS
BEACON_TLS_CERT=certs/server.crt
BEACON_TLS_KEY=certs/server.key

# Encryption (base64 encoded 32-byte AES-256 key)
BEACON_ENCRYPTION_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Agent settings
BEACON_AGENT_HEARTBEAT_TIMEOUT=60
BEACON_MAX_AGENTS=1000
