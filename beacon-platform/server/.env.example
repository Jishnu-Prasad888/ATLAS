# Beacon Server Environment Variables
# Copy to .env and fill in values

SECRET_KEY=beacon-change-me-in-production-use-a-long-random-string-here
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-domain.com

# PostgreSQL
DB_NAME=beacon
DB_USER=beacon
DB_PASSWORD=beacon
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# TLS
BEACON_TLS_CERT=certs/server.crt
BEACON_TLS_KEY=certs/server.key

# Encryption (base64 encoded 32-byte AES-256 key)
BEACON_ENCRYPTION_KEY=beacon-change-me-in-production-use-a-long-random-string-here

# CORS (comma-separated). Use "*" for allow-all during local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

BEACON_MAX_AGENTS=1000

# ─── Agent Registration Secret ────────────────────────────────────────────────
# All agents must present this secret during registration.
# Set the SAME value in the agent's BEACON_AGENT_SECRET env var (or agent.toml).
# Use a long random string — at least 32 characters recommended.
#
# Generate a strong secret:
#   python3 -c "import secrets; print(secrets.token_urlsafe(40))"
#
BEACON_AGENT_SECRET=change-this-to-a-strong-random-secret

# ─── Django / DRF ─────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=beacon.example.com,localhost

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://beacon:password@localhost:5432/beacon

# ─── Agent heartbeat timeout (seconds) ───────────────────────────────────────
BEACON_AGENT_HEARTBEAT_TIMEOUT=60

# ─── NATS Transport ───────────────────────────────────────────────────────────
BEACON_ENABLE_NATS_WORKER=1
BEACON_NATS_URL=nats://localhost:4222
BEACON_NATS_SUBJECT_PREFIX=agent
BEACON_NATS_COMMAND_PREFIX=agent_cmd
BEACON_NATS_STREAM_INGEST=agent_ingest
BEACON_NATS_STREAM_CONTROL=agent_control
BEACON_NATS_INGEST_CONSUMER=beacon-server
