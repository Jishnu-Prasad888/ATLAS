# Sample Beacon agent configuration (copy to /etc/beacon/agent.toml)

rest_base_url = "http://localhost:8000"
username = "admin"
# password is optional if BEACON_AGENT_PASSWORD is supplied at runtime
password = "bluematrix"
# Secret must match BEACON_AGENT_SECRET on the server (env var preferred)
secret = "change-this-to-a-strong-random-secret"
storage_dir = "/var/lib/beacon/agent"
interval_seconds = 5

[nats]
url = "nats://localhost:4222"
subject_prefix = "agent"
command_prefix = "agent_cmd"
# Optional extras:
# domain = "hub"
# creds_path = "/etc/beacon/nats.creds"
# connect_timeout = 5

[collectors]
cpu = true
ram = true
storage = true
network = true
process = true
systemd = true
system_inventory = true
docker = false
kubernetes = false
temperature = true
power = false
gpu = true
max_processes = 512

[tls]
verify_cert = true

[queue]
max_retries = 5
max_queue_size = 100000
retry_backoff_ms = 1000
sent_retention_hours = 24

[encryption]
enabled = true
key_rotation_days = 30

[logging]
max_log_rate = 1000
log_to_file = false
log_file_path = "/var/log/beacon/agent.log"
warning_audit_retention_days = 10
compress_warning_audit = true
